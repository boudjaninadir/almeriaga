# URL publique du site (SEO, metadata, OpenGraph, sitemap, robots.txt)
# En production, la valeur DOIT être https://almeriaga.vercel.app (ou le domaine définitif).
NEXT_PUBLIC_SITE_URL=https://almeriaga.vercel.app

# Numéro WhatsApp officiel : format international, sans "+" ni espaces (ex : 213550000000).
NEXT_PUBLIC_WHATSAPP_NUMBER=213550000000

# Adresses e-mail affichées dans le pied de page et les mentions légales.
NEXT_PUBLIC_CONTACT_EMAIL=hello@almeriaga.com
NEXT_PUBLIC_EMAIL_HELLO=hello@almeriaga.com
NEXT_PUBLIC_EMAIL_COMMANDES=commandes@almeriaga.com
NEXT_PUBLIC_EMAIL_GROS=gros@almeriaga.com
NEXT_PUBLIC_EMAIL_FOURNISSEURS=fournisseurs@almeriaga.com
NEXT_PUBLIC_EMAIL_SUPPORT=support@almeriaga.com

# Identité légale du vendeur (affichée en pied de page et dans /mentions-legales).
NEXT_PUBLIC_SELLER_NAME=Nadir Boudjani
NEXT_PUBLIC_SELLER_ANAE=ANAE-2026-9988
NEXT_PUBLIC_SELLER_NIF=002616000000000
NEXT_PUBLIC_SELLER_CITY=Alger

# Pixels publicitaires : laisser vide pour désactiver (aucun script n'est alors injecté).
# Meta : identifiant numérique du pixel. TikTok : identifiant alphanumérique.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Mode dry-run des leads (true = affiche dans la console serveur au lieu d'appeler le webhook Google Sheets)
LEADS_DRY_RUN=true

# Webhook Google Apps Script (URL de l'application web déployée et secret partagé)
LEADS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
LEADS_WEBHOOK_SECRET=votre_secret_partage_robuste

# Origines supplémentaires autorisées à envoyer des leads (séparées par des virgules).
# Utile pour les aperçus de déploiement Vercel et les tests locaux.
ALLOWED_ORIGINS=

# Catalogue Supabase (facultatif : sans ces variables, les produits de démonstration sont utilisés)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

