# ---------------------------------------------------------------------------
# ALMERÍAGA — variables d'environnement (à copier dans .env.local)
# Aucune valeur personnelle n'est fournie par défaut : ce qui est vide est masqué
# dans l'interface (aucun numéro, aucun e-mail, aucun prix inventé).
# ---------------------------------------------------------------------------

# URL publique du site (SEO, OpenGraph, sitemap, URL canoniques).
NEXT_PUBLIC_SITE_URL=https://almeriaga.vercel.app

# Nom de marque affiché (logo texte, titres, pied de page).
NEXT_PUBLIC_BRAND_NAME=ALMERÍAGA

# TODO : numéro WhatsApp officiel, format international SANS "+" ni espaces.
# Exemple de forme attendue : 213XXXXXXXXX (9 chiffres après l'indicatif).
# Vide = tous les liens WhatsApp sont masqués.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# TODO : adresse e-mail de contact. Vide = les liens e-mail sont masqués.
NEXT_PUBLIC_CONTACT_EMAIL=

# Pixel Meta : identifiant numérique. Vide = pixel désactivé.
# Événements envoyés : ViewContent (fiches produit) et Lead (/merci).
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase (lecture publique du catalogue + insertion des demandes via la clé anon).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modules internes (/simulateur et /admin/suivi).
# Sans ces deux variables, les routes répondent 404.
ADMIN_USER=
ADMIN_PASSWORD=

# Mode test : true = les demandes sont seulement écrites dans les logs serveur.
LEADS_DRY_RUN=false

# Origines supplémentaires autorisées à envoyer des demandes (aperçus Vercel, tests).
ALLOWED_ORIGINS=


